<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stages models and items into a cache directory through the same public calls the editor's
    Entities page makes, then saves through RSCache.WriteCache, for a machine where the editor's
    UI cannot be driven. Outside FlashEditor.sln: build it by path, with an artifacts path of its
    own if the editor's bin\Debug is in use.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>stage</AssemblyName>
    <RootNamespace>FlashEditor.Tools.CacheStage</RootNamespace>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FlashEditor\FlashEditor.csproj" />
  </ItemGroup>

</Project>
