<Project Sdk="Microsoft.NET.Sdk">
        <PropertyGroup>
                <TargetFramework>net9.0-windows</TargetFramework>
                <IsPackable>false</IsPackable>
                <LangVersion>latest</LangVersion>
                <EnableWindowsTargeting>true</EnableWindowsTargeting>
                <ImplicitUsings>false</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FlashEditor\FlashEditor.csproj" />
	</ItemGroup>

	<!-- Bytes captured from a real revision-639 cache. Small enough to commit, so the codec
	     stays pinned to shipped bytes on machines that have no cache to point the
	     conformance suite at. -->
	<ItemGroup>
		<!-- Always, not PreserveNewest: these are compared byte for byte, and a stale copy
		     left in the output directory fails the tests in a way that looks like a codec
		     regression rather than a build artefact. -->
		<None Include="Fixtures\RealCache\*.bin" CopyToOutputDirectory="Always" />
	</ItemGroup>
</Project>
